# Gmail SMTP settings for authenticated AEROTRAC contact messages
GMAIL_USER=your-aerotrac-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
CONTACT_TO=your-aerotrac-gmail@gmail.com

# Admin password used by the server-side booking confirmation endpoint.
AEROTRAC_ADMIN_PASSWORD=change-this-to-a-strong-password
# UPI payment destination used by the current payment flow
AEROTRAC_PAYMENT_UPI=kk3961230@okicici
# Add the payment-provider API credentials here later when the live gateway is available.
PAYMENT_PROVIDER_API_ID=
PAYMENT_PROVIDER_API_SECRET=
# Optional: move the JSON database to a persistent mounted volume in production.
AEROTRAC_DATA_FILE=./server-data/aerotrac.json
